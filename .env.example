# Copy this file to .env.local and fill in your own values
# NEVER commit .env.local to version control

# ==============================
# REQUIRED - Get your own keys
# ==============================

# Resend (Email notifications)
# Sign up: https://resend.com
RESEND_API_KEY=your_resend_api_key_here

# ==============================
# OPTIONAL - Only if using these features
# ==============================

# Shopify Integration
# Optional - only if connecting to Shopify
# NEXT_PUBLIC_SHOPIFY_STORE_URL=your-store.myshopify.com
# SHOPIFY_ADMIN_API_TOKEN=your_admin_api_token

# Claude AI (for brand analysis, design generation)
# Optional - only if using AI features
# ANTHROPIC_API_KEY=your_anthropic_api_key

# Mapbox (for map feature in configurator)
# Optional - only if using map/location features
# MAPBOX_ACCESS_TOKEN=your_mapbox_token

# ==============================
# INTERNAL - Contact original author if needed
# ==============================
# NEXT_PUBLIC_SHOPIFY_STORE_URL=izy-bottles.myshopify.com
# SHOPIFY_ADMIN_API_TOKEN=shpat_xxxx
# ANTHROPIC_API_KEY=sk-ant-xxxx
# MAPBOX_ACCESS_TOKEN=pk.xxxx
