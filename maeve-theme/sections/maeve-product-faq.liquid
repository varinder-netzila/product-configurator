{%- assign pairs = faq | split: ':::' -%}

<section class="pfaq">
  <div class="wrap pfaq-wrap">
    <div class="pfaq-head">
      <span class="pfaq-eyebrow">{% render 'maeve-t', nl: section.settings.eyebrow, en: 'Frequently asked questions', es: 'Preguntas frecuentes', fr: 'Questions fréquentes', de: 'Häufige Fragen' %}</span>
      <h2>{% render 'maeve-t', nl: section.settings.heading, en: 'All about the', es: 'Todo sobre el', fr: 'Tout savoir sur le', de: 'Alles über das' %} {{ design }} {{ uitL }}</h2>
    </div>
    <div class="pfaq-list">
      {%- for pair in pairs -%}
        {%- assign qa = pair | split: '==>' -%}
        <details class="pfaq-item"{% if forloop.first %} open{% endif %}>
          <summary>{{ qa[0] | strip }}</summary>
          <div class="pfaq-a">{{ qa[1] | strip }}</div>
        </details>
      {%- endfor -%}
    </div>
  </div>
</section>

<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for pair in pairs -%}
      {%- assign qa = pair | split: '==>' -%}
      {
        "@type": "Question",
        "name": {{ qa[0] | strip | json }},
        "acceptedAnswer": { "@type": "Answer", "text": {{ qa[1] | strip | json }} }
      }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>

{% stylesheet %}
.pfaq { padding: 64px 0; background: var(--sand); }
.pfaq-wrap { display: grid; grid-template-columns: 0.8fr 1.4fr; gap: 56px; align-items: start; }
.pfaq-eyebrow { display: block; font-size: 11px; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: var(--clay); margin-bottom: 14px; }
.pfaq-head h2 { font-family: var(--serif); font-size: clamp(28px, 3vw, 42px); line-height: 1.1; color: var(--ink); }
.pfaq-list { border-top: 1px solid var(--line); }
.pfaq-item { border-bottom: 1px solid var(--line); }
.pfaq-item summary { list-style: none; cursor: pointer; padding: 20px 40px 20px 0; position: relative; font-family: var(--serif); font-size: 18px; color: var(--ink); }
.pfaq-item summary::-webkit-details-marker { display: none; }
.pfaq-item summary::after { content: '+'; position: absolute; right: 4px; top: 50%; transform: translateY(-50%); font-size: 22px; color: var(--clay); font-family: var(--sans); transition: transform .25s ease; }
.pfaq-item[open] summary::after { content: '–'; }
.pfaq-a { padding: 0 40px 22px 0; color: var(--ink-soft); font-size: 15px; line-height: 1.65; max-width: 60ch; }
@media (max-width: 900px) {
  .pfaq { padding: 48px 0; }
  .pfaq-wrap { grid-template-columns: 1fr; gap: 24px; }
  .pfaq-item summary { font-size: 16px; padding: 17px 36px 17px 0; }
  .pfaq-a { font-size: 14.5px; }
}
{% endstylesheet %}

