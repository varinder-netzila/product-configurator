{%- comment -%} Product-specifieke, SEO-sterke FAQ + FAQPage JSON-LD {%- endcomment -%}
{%- assign design = product.metafields.geur.design.value | default: product.title -%}
{%- assign uit = product.metafields.geur.uitvoering.value | default: 'Roomspray' -%}
{%- assign _iso = localization.language.iso_code -%}
{%- assign vSpray = 'Roomspray' -%}{%- assign vStok = 'Geurstokjes' -%}{%- assign vNav = 'Navulling' -%}
{%- case _iso -%}
{%- when 'en' -%}{%- assign vSpray = 'Room Spray' -%}{%- assign vStok = 'Reed Diffuser' -%}{%- assign vNav = 'Refill' -%}
{%- when 'es' -%}{%- assign vSpray = 'Spray de Ambiente' -%}{%- assign vStok = 'Difusor de Varillas' -%}{%- assign vNav = 'Recarga' -%}
{%- when 'fr' -%}{%- assign vSpray = "Spray d'Ambiance" -%}{%- assign vStok = 'Diffuseur à Bâtonnets' -%}{%- assign vNav = 'Recharge' -%}
{%- when 'de' -%}{%- assign vSpray = 'Raumspray' -%}{%- assign vStok = 'Duftstäbchen' -%}{%- assign vNav = 'Nachfüllung' -%}
{%- endcase -%}
{%- assign uitL = uit | downcase -%}
{%- assign familie = product.metafields.geur.familie.value | default: 'verfijnde' -%}
{%- assign familieL = familie | downcase -%}
{%- assign kop = product.metafields.geur.kop.value -%}
{%- assign hart = product.metafields.geur.hart.value -%}
{%- assign basis = product.metafields.geur.basis.value -%}
{%- assign noteline = '' -%}
{%- if kop != blank -%}{%- assign noteline = kop -%}{%- if hart != blank -%}{%- assign noteline = noteline | append: ', ' | append: hart -%}{%- endif -%}{%- if basis != blank -%}{%- assign noteline = noteline | append: ', ' | append: basis -%}{%- endif -%}{%- assign noteline = noteline | downcase -%}{%- else -%}{%- assign noteline = familieL -%}{%- endif -%}
{%- assign inspiratie = product.metafields.geur.inspiratie.value | strip_html | strip -%}

{%- comment -%} formaten + prijzen {%- endcomment -%}
{%- assign formaten = '' -%}
{%- for v in product.variants -%}
  {%- assign pm = v.price | money -%}
  {%- assign formaten = formaten | append: v.title | append: ' (' | append: pm | append: ')' -%}
  {%- unless forloop.last -%}{%- assign formaten = formaten | append: ', ' -%}{%- endunless -%}
{%- endfor -%}

