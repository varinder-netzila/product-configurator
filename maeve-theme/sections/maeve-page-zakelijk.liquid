{% render 'maeve-page-zakelijk-css' %}

<!-- ===== HERO ===== -->
<section class="b2b-hero">
  <div class="wrap">
    <span class="eyebrow">{{ section.settings.hero_eyebrow }}</span>
    <h1>{{ section.settings.hero_heading }}</h1>
    <p>{{ section.settings.hero_text }}</p>
    <div class="usps">
      {% for block in section.blocks %}
        {% if block.type == 'usp' %}
          <span {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ===== SEGMENTS ===== -->
<section class="segments">
  <div class="wrap seg-grid">
    {% for block in section.blocks %}
      {% if block.type == 'segment' %}
        <div class="seg reveal" {% if block.settings.delay != blank %}style="{{ block.settings.delay }}"{% endif %} {{ block.shopify_attributes }}>
          <img class="bg" src="{% if block.settings.image %}{{ block.settings.image | image_url: width: 1400 }}{% else %}{{ block.settings.image_fallback | asset_url }}{% endif %}" alt="" loading="lazy">
          <div class="meta"><h3>{{ block.settings.title }}</h3><p>{{ block.settings.subtitle }}</p></div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</section>

<!-- ===== WERKWIJZE ===== -->
<section class="werkwijze">
  <div class="wrap">
    <div class="head reveal">
      <span class="eyebrow">{{ section.settings.werkwijze_eyebrow }}</span>
      <h2>{{ section.settings.werkwijze_heading }}</h2>
    </div>
    <div class="steps">
      {% for block in section.blocks %}
        {% if block.type == 'step' %}
          <div class="step reveal" {% if block.settings.delay != blank %}style="{{ block.settings.delay }}"{% endif %} {{ block.shopify_attributes }}>
            <span class="num">{{ block.settings.num }}</span>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

<!-- ===== STAFFEL ===== -->
<section class="staffel">
  <div class="wrap grid2">
    <div class="copy reveal">
      <span class="eyebrow">{{ section.settings.staffel_eyebrow }}</span>
      <h2>{{ section.settings.staffel_heading }}</h2>
      <p>{{ section.settings.staffel_text1 }}</p>
      <p>{{ section.settings.staffel_text2 }}</p>
    </div>
    <div class="reveal">
      <table>
        <thead><tr><th>{{ section.settings.table_col1 }}</th><th>{{ section.settings.table_col2 }}</th><th>{{ section.settings.table_col3 }}</th></tr></thead>
        <tbody>
          {% for block in section.blocks %}
            {% if block.type == 'tier' %}
              <tr {% if block.settings.highlight %}class="hl"{% endif %} {{ block.shopify_attributes }}><td class="amount">{{ block.settings.amount }}</td><td class="price">{{ block.settings.price1 }}</td><td class="price">{{ block.settings.price2 }}</td></tr>
            {% endif %}
          {% endfor %}
        </tbody>
      </table>
      <p class="table-note">{{ section.settings.table_note }}</p>
    </div>
  </div>
</section>

<!-- ===== AANVRAAG ===== -->
<section class="aanvraag" id="aanvraag">
  <div class="wrap grid2">
    <div class="copy reveal">
      <span class="eyebrow">{{ section.settings.form_eyebrow }}</span>
      <h2>{{ section.settings.form_heading }}</h2>
      <p>{{ section.settings.form_text }}</p>
      <p>{{ section.settings.form_contact_pre }} <a href="mailto:{{ section.settings.form_email }}" style="border-bottom:1px solid var(--clay); color:var(--clay)">{{ section.settings.form_email }}</a>.</p>
    </div>
    <form id="b2bForm" class="reveal">
      <div class="field"><label>{{ section.settings.label_company }}</label><input type="text" required></div>
      <div class="field"><label>{{ section.settings.label_contact }}</label><input type="text" required></div>
      <div class="field"><label>{{ section.settings.label_email }}</label><input type="email" required></div>
      <div class="field"><label>{{ section.settings.label_orgtype }}</label>
        <select>
          {% for block in section.blocks %}
            {% if block.type == 'orgtype' %}
              <option {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
      <div class="field"><label>{{ section.settings.label_volume }}</label>
        <select>
          {% for block in section.blocks %}
            {% if block.type == 'volume' %}
              <option {{ block.shopify_attributes }}>{{ block.settings.label }}</option>
            {% endif %}
          {% endfor %}
        </select>
      </div>
      <div class="field full"><label>{{ section.settings.label_message }}</label><textarea placeholder="{{ section.settings.placeholder_message }}"></textarea></div>
      <div class="field full"><button class="btn solid" type="submit">{{ section.settings.button_label }}</button></div>
      <p class="form-ok" id="formOk">{{ section.settings.form_ok }}</p>
    </form>
  </div>
</section>

