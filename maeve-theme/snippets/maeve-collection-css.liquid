<style>
  :root {
    --ivory: #F6F1E9;
    --sand: #ECE4D6;
    --sand-deep: #E0D4BE;
    --ink: #211D18; --petrol: #20393B;
    --ink-soft: #4A443C;
    --clay: #A65A3F;
    --clay-dark: #8C4830;
    --line: rgba(33,29,24,.14);
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Inter', -apple-system, sans-serif;
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body {
    font-family: var(--sans);
    background: var(--ivory);
    color: var(--ink);
    font-size: 16px;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  h1, h2, h3, .serif { font-family: var(--serif); font-weight: 400; line-height: 1.08; }
  a { color: inherit; text-decoration: none; }
  .wrap { max-width: 1280px; margin: 0 auto; padding: 0 36px; }
  .eyebrow {
    font-size: 11.5px; font-weight: 600;
    letter-spacing: .24em; text-transform: uppercase;
    color: var(--clay);
  }

  /* ================= NAV ================= */
  header {
    position: sticky; top: 0; z-index: 60;
    background: rgba(246,241,233,.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }
  nav { display: flex; align-items: center; justify-content: space-between; height: 70px; }
  .nav-links { display: flex; gap: 34px; font-size: 13px; letter-spacing: .05em; font-weight: 500; }
  .nav-links a:hover { opacity: .5; }
  .nav-links a.hl { color: var(--clay); }
  .logo { font-family: var(--serif); font-size: 29px; font-weight: 600; letter-spacing: .01em; }
  .nav-side { width: 270px; }
  .nav-side.right { display: flex; justify-content: flex-end; gap: 22px; font-size: 13px; font-weight: 500; }
  @media (max-width: 900px) { .nav-links { display: none; } .nav-side { width: auto; } }

  .btn {
    display: inline-block;
    padding: 16px 36px;
    font-family: var(--sans);
    font-size: 12.5px; font-weight: 600;
    letter-spacing: .12em; text-transform: uppercase;
    border: 1px solid var(--ink);
    background: transparent; color: var(--ink);
    cursor: pointer;
    transition: all .3s ease;
  }
  .btn.solid { background: var(--ink); color: var(--ivory); }
  .btn.solid:hover { background: var(--clay-dark); border-color: var(--clay-dark); }
  .btn.light { border-color: var(--ivory); color: var(--ivory); }
  .btn.light:hover { background: var(--ivory); color: var(--ink); }

  /* ================= COLLECTION HEADER ================= */
  .col-head { padding: 40px 0 0; }
  .col-head .crumb { font-size: 12px; color: var(--ink-soft); margin-bottom: 22px; }
  .col-head .crumb a:hover { color: var(--ink); }
  .col-head .crumb .sep { margin: 0 10px; opacity: .5; }
  .col-head .room {
    font-family: var(--serif); font-style: italic;
    font-size: 16px; color: var(--clay);
    margin-bottom: 12px;
  }
  .col-head h1 { font-size: clamp(36px, 3.8vw, 56px); max-width: 18ch; margin-bottom: 16px; }
  .col-head h1 em { font-style: italic; font-weight: 300; }
  .zaaltekst {
    max-width: 60ch;
    color: var(--ink-soft);
    font-size: 15.5px;
    margin-bottom: 10px;
  }
  .col-meta {
    font-size: 12.5px; letter-spacing: .08em;
    color: var(--ink-soft);
    margin-bottom: 30px;
  }
  .col-meta b { color: var(--ink); font-weight: 600; }

  /* ================= ROOM TABS ================= */
  .rooms {
    display: flex; gap: 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .room-tab {
    flex: 1;
    min-width: 180px;
    padding: 22px 26px;
    border-left: 1px solid var(--line);
    cursor: pointer;
    transition: background .3s;
    background: transparent;
    text-align: left;
    font-family: var(--sans);
  }
  .room-tab:first-child { border-left: 0; }
  .room-tab:hover { background: rgba(33,29,24,.04); }
  .room-tab.active { background: var(--ink); }
  .room-tab .zaal {
    font-family: var(--serif); font-style: italic;
    font-size: 13.5px; color: var(--clay);
    display: block; margin-bottom: 3px;
  }
  .room-tab .naam { font-family: var(--serif); font-size: 19px; color: var(--ink); }
  .room-tab.active .naam { color: var(--ivory); }
  .room-tab.active .zaal { color: #D8C7A6; }

  /* ================= FILTER BAR ================= */
  .filterbar {
    display: flex; justify-content: space-between; align-items: center;
    gap: 24px; flex-wrap: wrap;
    padding: 24px 0 6px;
  }
  .filters { display: flex; gap: 10px; flex-wrap: wrap; }
  .fchip {
    padding: 10px 18px;
    border: 1px solid var(--line);
    font-size: 12.5px; font-weight: 500;
    cursor: pointer;
    background: transparent;
    font-family: var(--sans);
    color: var(--ink);
    transition: all .25s;
  }
  .fchip:hover { border-color: var(--ink-soft); }
  .fchip.active { background: var(--ink); border-color: var(--ink); color: var(--ivory); }
  .count { font-size: 12.5px; color: var(--ink-soft); letter-spacing: .06em; }
  .filters { display: flex; gap: 18px 22px; flex-wrap: wrap; align-items: center; }
  .filter-group { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
  .filter-group .flabel { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); margin-right: 2px; }
  .filter-group .fchip { padding: 7px 14px; font-size: 12px; }
  .filter-empty { text-align: center; color: var(--ink-soft); font-family: var(--serif); font-style: italic; font-size: 17px; padding: 30px 0 10px; }
  @media (max-width: 700px) { .filterbar { flex-direction: column; align-items: flex-start; } .filters { gap: 12px 16px; } }

  /* ===== gegroepeerd per collectie (Alle geuren) ===== */
  .collgroup { margin-top: 56px; }
  .collgroup:first-child { margin-top: 8px; }
  .collgroup-head { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; margin-bottom: 26px; padding-bottom: 14px; border-bottom: 1px solid var(--line); }
  .collgroup-title { font-family: var(--serif); font-size: clamp(24px, 3.2vw, 36px); line-height: 1.1; color: var(--ink); margin: 0; }
  .collgroup-link { flex: none; font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); text-decoration: none; border-bottom: 1px solid var(--line); padding-bottom: 2px; white-space: nowrap; }
  .collgroup-link:hover { color: var(--ink); }
  @media (max-width: 700px) { .collgroup { margin-top: 44px; } .collgroup-head { margin-bottom: 18px; } }

  /* ================= GRID ================= */
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 28px;
    padding: 26px 0 30px;
  }
  @media (max-width: 1000px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 14px; padding: 18px 0 24px; } }
  /* mobiel: zaal-tabs als nette 2x2 i.p.v. smalle scroll */
  @media (max-width: 700px) {
    .rooms { display: grid; grid-template-columns: 1fr 1fr; overflow: visible; }
    .room-tab { min-width: 0; padding: 14px 14px; }
    .room-tab:nth-child(odd) { border-left: 0; }
    .room-tab:nth-child(n+3) { border-top: 1px solid var(--line); }
    .room-tab .naam { font-size: 15px; }
    .room-tab .zaal { font-size: 11px; }
  }

  .piece { position: relative; display: flex; flex-direction: column; }
  .piece .pedestal {
    background: radial-gradient(125% 95% at 50% 22%, #F7F1E4 0%, var(--sand) 52%, var(--sand-deep) 100%);
    aspect-ratio: 1 / 1.12;
    display: flex; align-items: flex-end; justify-content: center;
    position: relative;
    overflow: hidden;
    cursor: pointer;
  }
  .piece .pedestal .bottle { z-index: 2; margin-bottom: 36px; transform: scale(.74); transform-origin: bottom center; transition: transform .5s ease; }
  .piece .pedestal .bottle::after {
    content: '';
    position: absolute; left: 50%; bottom: 9%; transform: translateX(-50%);
    width: 56%; height: 22px;
    background: radial-gradient(ellipse at center, rgba(33,29,24,.26), transparent 72%);
  }
  .piece:hover .pedestal .bottle { transform: scale(.74) translateY(-8px); }
  .piece .pedestal .prod-photo { z-index: 2; height: 92%; margin-bottom: 7%; object-fit: contain; object-position: bottom; transition: transform .5s ease; filter: drop-shadow(0 28px 14px rgba(33,29,24,.18)); }
  .piece:hover .pedestal .prod-photo { transform: translateY(-8px); }
  .piece .no {
    position: absolute; top: 18px; left: 22px;
    font-family: var(--serif); font-style: italic;
    font-size: 14px; color: var(--ink-soft);
    z-index: 3;
  }
  .piece .tag {
    position: absolute; top: 18px; right: 18px;
    z-index: 3;
    font-size: 10px; font-weight: 600;
    letter-spacing: .14em; text-transform: uppercase;
    background: var(--ivory);
    padding: 5px 11px;
  }
  .mlabel {
    background: #FBF8F2;
    border: 1px solid var(--line);
    border-top: 0;
    padding: 20px 22px;
    font-size: 12.5px; color: var(--ink-soft); line-height: 1.55;
    flex: 1;
    display: flex; flex-direction: column;
  }
  .mlabel .artist { font-weight: 600; font-size: 10.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--ink); }
  .mlabel .title { font-family: var(--serif); font-style: italic; font-size: 18px; color: var(--ink); margin: 2px 0 6px; }
  .mlabel .row {
    display: flex; justify-content: space-between; align-items: baseline;
    border-top: 1px solid var(--line);
    margin-top: auto; padding-top: 12px;
  }
  .mlabel .row { margin-top: 14px; }
  .mlabel .price { font-family: var(--serif); font-size: 17px; color: var(--ink); }
  .mlabel .go {
    font-size: 10.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase;
    color: var(--clay);
    border-bottom: 1px solid var(--clay);
    padding-bottom: 2px;
  }
  .mlabel .go:hover { color: var(--clay-dark); }

  /* ================= BOTTLES ================= */
  .bottle { position: relative; }
  .spray { width: 150px; }
  .spray .cap { width: 46px; height: 56px; margin: 0 auto; background: linear-gradient(90deg, #D8D2C6, #FCFAF5 45%, #C4BDB0); border-radius: 6px 6px 2px 2px; }
  .spray .neck { width: 68px; height: 16px; margin: 0 auto; background: linear-gradient(90deg, #C9BBA2, #F0E8D8 45%, #B5A88E); }
  .spray .body {
    width: 150px; height: 380px;
    border-radius: 14px 14px 18px 18px;
    overflow: hidden; position: relative;
    box-shadow: 0 30px 50px -20px rgba(33,29,24,.4);
  }
  .label { position: absolute; inset: 0; background-size: 300px 100%; background-position-x: 0; transition: background-position-x 1.6s cubic-bezier(.22,.8,.3,1); }
  .piece:hover .spray .label { background-position-x: 300px; }
  .piece:hover .diffuser .label { background-position-x: 264px; }
  .spray .body::after, .diffuser .body::after {
    content: '';
    position: absolute; inset: 0;
    background: linear-gradient(90deg, rgba(33,29,24,.3) 0%, rgba(255,255,255,.22) 16%, rgba(255,255,255,0) 38%, rgba(255,255,255,0) 62%, rgba(255,255,255,.14) 84%, rgba(33,29,24,.34) 100%);
    pointer-events: none;
  }
  .brandmark {
    position: absolute; left: 0; right: 0; bottom: 28px;
    text-align: center;
    font-family: var(--serif);
    font-size: 14px; letter-spacing: .32em; text-indent: .32em;
    color: rgba(255,255,255,.96);
    z-index: 3;
    text-shadow: 0 1px 6px rgba(33,29,24,.4);
    pointer-events: none;
  }
  .brandmark span { display: block; font-family: var(--sans); font-size: 7.5px; letter-spacing: .2em; margin-top: 4px; opacity: .85; }

  .diffuser { width: 132px; }
  .sticks { position: relative; height: 150px; margin-bottom: -12px; z-index: 1; }
  .stick { position: absolute; bottom: 0; left: 50%; width: 3px; height: 160px; background: linear-gradient(180deg, #9A7B52, #6E5638); border-radius: 2px; transform-origin: bottom center; }
  .diffuser .neck { width: 44px; height: 26px; margin: 0 auto; background: linear-gradient(90deg, #C9BBA2, #F0E8D8 45%, #B5A88E); border-radius: 3px 3px 0 0; position: relative; z-index: 2; }
  .diffuser .body { width: 132px; height: 212px; border-radius: 10px 10px 14px 14px; overflow: hidden; position: relative; box-shadow: 0 24px 40px -18px rgba(33,29,24,.38); }
  .diffuser .label { background-size: 264px 100%; }

  /* ================= PRINTS ================= */
  .print-art { background-color: #D9A93C; background-image: radial-gradient(circle 26px at 30% 26%, #7A4E16 0 38%, #C9892A 52%, transparent 70%), radial-gradient(circle 22px at 66% 48%, #7A4E16 0 36%, #D9A93C 55%, transparent 72%), radial-gradient(circle 20px at 40% 74%, #8A5A1C 0 38%, #E8C25A 56%, transparent 74%), radial-gradient(circle 52px at 82% 14%, #E8C25A 98%, transparent), radial-gradient(circle 44px at 10% 58%, #C9952E 98%, transparent), radial-gradient(circle 36px at 88% 84%, #B57F23 98%, transparent); }
  .print-art2 { background-color: #7FA89B; background-image: radial-gradient(circle 10px at 26% 28%, #F4E9E2 98%, transparent), radial-gradient(circle 8px at 54% 16%, #EFDCD8 98%, transparent), radial-gradient(circle 11px at 74% 44%, #F4E9E2 98%, transparent), radial-gradient(circle 8px at 38% 56%, #E8CBC9 98%, transparent), radial-gradient(circle 10px at 64% 78%, #F4E9E2 98%, transparent), radial-gradient(circle 7px at 16% 80%, #EFDCD8 98%, transparent), linear-gradient(112deg, transparent 44%, #5D4A3A 44.2%, #5D4A3A 46%, transparent 46.2%), linear-gradient(70deg, transparent 62%, #6B5849 62.2%, #6B5849 63.6%, transparent 63.8%); }
  .print-art3 { background-color: #6E8FB3; background-image: radial-gradient(ellipse 60px 14px at 28% 18%, #D8E2EC 96%, transparent), radial-gradient(ellipse 50px 12px at 72% 30%, #C5D3E2 96%, transparent), radial-gradient(ellipse 44px 12px at 50% 10%, #E4EBF2 96%, transparent), linear-gradient(180deg, transparent 0 52%, #C9972F 52% 64%, #B57F23 64% 78%, #D8A93C 78% 90%, #9C6F1E 90% 100%); }
  .print-map { background-color: #2E4438; background-image: repeating-radial-gradient(circle at 70% 30%, transparent 0 14px, rgba(236,228,214,.5) 14px 15px), repeating-radial-gradient(circle at 20% 75%, transparent 0 20px, rgba(236,228,214,.32) 20px 21px); }
  .print-map2 { background-color: #2A3A48; background-image: repeating-radial-gradient(circle at 66% 32%, transparent 0 14px, rgba(214,222,234,.45) 14px 15px), repeating-radial-gradient(circle at 22% 74%, transparent 0 20px, rgba(214,222,234,.28) 20px 21px); }
  .print-map3 { background-color: #8C7A5A; background-image: repeating-radial-gradient(circle at 72% 28%, transparent 0 14px, rgba(246,241,233,.55) 14px 15px), repeating-radial-gradient(circle at 18% 76%, transparent 0 20px, rgba(246,241,233,.35) 20px 21px); }
  .print-city { background-color: #1F2733; background-image: repeating-linear-gradient(90deg, transparent 0 22px, rgba(214,222,234,.4) 22px 23px), repeating-linear-gradient(0deg, transparent 0 30px, rgba(214,222,234,.28) 30px 31px), radial-gradient(circle 5px at 40% 35%, #D9A441 98%, transparent), radial-gradient(circle 4px at 68% 60%, #D9A441 98%, transparent); }
  .print-city2 { background-color: #243528; background-image: repeating-linear-gradient(90deg, transparent 0 22px, rgba(236,228,214,.38) 22px 23px), repeating-linear-gradient(0deg, transparent 0 30px, rgba(236,228,214,.26) 30px 31px), radial-gradient(circle 5px at 42% 36%, #D9A441 98%, transparent), radial-gradient(circle 4px at 66% 62%, #D9A441 98%, transparent); }
  .print-city3 { background-color: #3A2530; background-image: repeating-linear-gradient(90deg, transparent 0 22px, rgba(234,214,222,.36) 22px 23px), repeating-linear-gradient(0deg, transparent 0 30px, rgba(234,214,222,.24) 30px 31px), radial-gradient(circle 5px at 38% 34%, #E8B864 98%, transparent), radial-gradient(circle 4px at 70% 58%, #E8B864 98%, transparent); }
  .print-botanic { background-color: #6F7457; background-image: radial-gradient(ellipse 16px 50px at 25% 30%, #9BA37C 98%, transparent), radial-gradient(ellipse 14px 44px at 70% 55%, #4E543C 98%, transparent), radial-gradient(ellipse 18px 56px at 45% 85%, #BFC4A0 98%, transparent), radial-gradient(ellipse 12px 40px at 90% 20%, #59604A 98%, transparent); }
  .print-botanic2 { background-color: #4E5A50; background-image: radial-gradient(ellipse 16px 50px at 26% 32%, #8CA08E 98%, transparent), radial-gradient(ellipse 14px 44px at 72% 54%, #34403A 98%, transparent), radial-gradient(ellipse 18px 56px at 44% 86%, #B8C4B2 98%, transparent), radial-gradient(ellipse 12px 40px at 88% 22%, #C9A86A 98%, transparent); }
  .print-studio { background: repeating-linear-gradient(45deg, var(--sand) 0 14px, #E2D5BF 14px 28px); }

  /* ================= INTERLUDE QUOTE ================= */
  .interlude {
    border-top: 1px solid var(--line);
    margin-top: 50px;
    padding: 90px 24px;
    text-align: center;
  }
  .interlude blockquote {
    font-family: var(--serif); font-style: italic;
    font-size: clamp(24px, 2.8vw, 36px);
    line-height: 1.35;
    max-width: 30ch;
    margin: 0 auto 26px;
  }
  .interlude blockquote em { color: var(--clay); }
  .interlude cite { font-style: normal; font-size: 11.5px; font-weight: 600; letter-spacing: .22em; text-transform: uppercase; color: var(--ink-soft); }

  /* ================= NEXT ROOM / CTA ================= */
  .next-room {
    background: var(--petrol); color: var(--ivory);
    padding: 100px 24px;
    text-align: center;
  }
  .next-room .eyebrow { color: #D8C7A6; }
  .next-room h2 { font-size: clamp(30px, 3.4vw, 50px); color: var(--ivory); margin: 18px 0 14px; }
  .next-room h2 em { font-style: italic; font-weight: 300; }
  .next-room p { color: rgba(246,241,233,.66); max-width: 52ch; margin: 0 auto 40px; }
  .next-room .ctas { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  /* ================= FOOTER ================= */
  footer { border-top: 1px solid var(--line); padding: 70px 0 36px; }
  .foot-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 48px; margin-bottom: 60px; }
  .foot-grid .logo { font-size: 25px; margin-bottom: 4px; display: inline-block; }
  .foot-tagline { font-family: var(--serif); font-style: italic; font-size: 14px; color: var(--ink-soft); margin-bottom: 14px; }
  .foot-grid > div > p { font-size: 14px; color: var(--ink-soft); max-width: 34ch; }
  .foot-grid h4 { font-size: 11.5px; letter-spacing: .16em; text-transform: uppercase; margin-bottom: 18px; }
  .foot-grid ul { list-style: none; }
  .foot-grid li { margin-bottom: 10px; font-size: 14px; color: var(--ink-soft); }
  .foot-grid li a:hover { color: var(--ink); }
  .foot-bottom { display: flex; justify-content: space-between; font-size: 12.5px; color: var(--ink-soft); border-top: 1px solid var(--line); padding-top: 28px; }
  @media (max-width: 900px) { .foot-grid { grid-template-columns: 1fr 1fr; } }

  .reveal { opacity: 0; transform: translateY(26px); transition: opacity .8s ease, transform .8s ease; }
  .reveal.in { opacity: 1; transform: none; }

  .menu-btn { display: none; border: 0; background: transparent; font: 600 12px/1 var(--sans); letter-spacing: .14em; text-transform: uppercase; color: var(--ink); cursor: pointer; padding: 8px 0; }
  @media (max-width: 900px) { .menu-btn { display: block; } }
  .mobile-menu { display: none; position: fixed; top: 70px; left: 0; right: 0; background: var(--ivory); border-bottom: 1px solid var(--line); z-index: 59; flex-direction: column; padding: 10px 36px 24px; }
  .mobile-menu.open { display: flex; }
  .mobile-menu a { padding: 13px 0; border-bottom: 1px solid var(--line); font-size: 14px; font-weight: 500; }
  .mobile-menu a:last-child { border-bottom: 0; }

  /* ===== geurtonen linksboven, onder de 'no' ===== */
  .piece .pedestal { position: relative; }
  .ped-scent { position: absolute; top: 56px; left: 22px; z-index: 3; pointer-events: none; display: flex; flex-direction: column; gap: 1px; max-width: 62%; }
  .ped-scent span { font-family: var(--sans); font-size: 9px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--ink-soft); line-height: 1.35; }
  .mtones { display: none; }
  @media (max-width: 600px) {
    .ped-scent { display: none; }
    .mtones { display: block; font-family: var(--sans); font-size: 10px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: var(--clay); line-height: 1.45; margin-top: 5px; }
  }
</style>
