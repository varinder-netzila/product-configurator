<style>
  :root {
    --ivory: #F6F1E9; --sand: #ECE4D6; --sand-deep: #E0D4BE;
    --ink: #211D18; --petrol: #20393B; --ink-soft: #4A443C;
    --clay: #A65A3F; --clay-dark: #8C4830;
    --line: rgba(33,29,24,.14);
    --serif: 'EB Garamond', Georgia, serif;
    --sans: 'Inter', -apple-system, sans-serif;
  }
  .ab { font-family: var(--sans); color: var(--ink); background: var(--ivory); }
  .ab .wrap { max-width: 1280px; margin: 0 auto; padding: 0 36px; }
  .ab .eyebrow { font-size: 11.5px; font-weight: 600; letter-spacing: .24em; text-transform: uppercase; color: var(--clay); }
  .ab h1, .ab h2, .ab h3 { font-family: var(--serif); font-weight: 400; line-height: 1.08; }
  .ab em { font-style: italic; font-weight: 300; }

  /* hero */
  .ab-hero { padding: 70px 0 50px; text-align: center; }
  .ab-hero .eyebrow { display: block; margin-bottom: 18px; }
  .ab-hero h1 { font-size: clamp(40px, 5.2vw, 76px); max-width: 18ch; margin: 0 auto 22px; }
  .ab-hero p { max-width: 54ch; margin: 0 auto 30px; color: var(--ink-soft); font-size: 17.5px; }
  .ab-hero .scroll { display: inline-block; padding: 16px 36px; font: 600 12.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; background: var(--ink); color: var(--ivory); border: 1px solid var(--ink); cursor: pointer; transition: all .3s; }
  .ab-hero .scroll:hover { background: var(--clay-dark); border-color: var(--clay-dark); }

  /* how it works */
  .ab-how { background: var(--petrol); color: var(--ivory); padding: 100px 0; }
  .ab-how .head { text-align: center; max-width: 620px; margin: 0 auto 64px; }
  .ab-how .eyebrow { color: #D8C7A6; }
  .ab-how h2 { font-size: clamp(30px, 3.4vw, 48px); color: var(--ivory); margin-top: 14px; }
  .ab-how .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 46px; }
  @media (max-width: 820px) { .ab-how .steps { grid-template-columns: 1fr; gap: 36px; } }
  .ab-how .step { border-top: 1px solid rgba(246,241,233,.22); padding-top: 24px; }
  .ab-how .step .num { font-family: var(--serif); font-style: italic; font-size: 15px; color: #D8C7A6; display: block; margin-bottom: 12px; }
  .ab-how .step h3 { font-size: 22px; margin-bottom: 8px; }
  .ab-how .step p { font-size: 14.5px; color: rgba(246,241,233,.78); line-height: 1.65; }

  /* tracks */
  .ab-tracks { padding: 100px 0; }
  .ab-tracks .head { text-align: center; max-width: 600px; margin: 0 auto 56px; }
  .ab-tracks .head h2 { font-size: clamp(30px, 3.4vw, 48px); margin-top: 14px; }
  .ab-tracks .head p { margin-top: 14px; color: var(--ink-soft); font-size: 16px; }
  .ab-card-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 26px; align-items: start; }
  @media (max-width: 900px) { .ab-card-grid { grid-template-columns: 1fr; } }
  .ab-card { border: 1px solid var(--line); background: #fff; padding: 34px; position: relative; }
  .ab-card.feat { border-color: var(--ink); }
  .ab-card .tag { position: absolute; top: -12px; left: 34px; background: var(--clay); color: #fff; font-size: 10px; letter-spacing: .14em; text-transform: uppercase; padding: 5px 12px; }
  .ab-card h3 { font-size: 27px; margin-bottom: 8px; }
  .ab-card .lead { font-size: 14px; color: var(--ink-soft); margin-bottom: 24px; min-height: 42px; }
  .ab-card .price { font-family: var(--serif); font-size: 34px; margin-bottom: 2px; }
  .ab-card .price small { font-family: var(--sans); font-size: 13px; color: var(--ink-soft); }
  .ab-card .price-note { font-size: 12px; color: var(--ink-soft); margin-bottom: 22px; }

  .ab-field { margin-bottom: 18px; }
  .ab-field > label { display: block; font-size: 11.5px; font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--ink-soft); margin-bottom: 9px; }
  .ab-seg { display: inline-flex; border: 1px solid var(--ink); }
  .ab-seg button { font: 600 12px/1 var(--sans); padding: 11px 18px; background: transparent; color: var(--ink); border: 0; cursor: pointer; transition: all .25s; }
  .ab-seg button.active { background: var(--ink); color: var(--ivory); }
  .ab-chips { display: flex; gap: 8px; flex-wrap: wrap; }
  .ab-chip { font: 600 12px/1 var(--sans); padding: 11px 15px; border: 1px solid var(--line); background: #fff; cursor: pointer; transition: all .25s; }
  .ab-chip.active { box-shadow: inset 0 0 0 1px var(--ink); border-color: var(--ink); }
  .ab-chip.unavail { opacity: .4; cursor: not-allowed; text-decoration: line-through; }
  .ab-select { width: 100%; padding: 13px 14px; border: 1px solid var(--line); background: #fff; font: 500 14px/1 var(--sans); color: var(--ink); cursor: pointer; }

  /* frequentie-keuze + korting */
  .ab-freqs { display: flex; flex-direction: column; gap: 8px; }
  .ab-freq { display: flex; align-items: center; gap: 10px; border: 1px solid var(--line); background: #fff; padding: 12px 14px; cursor: pointer; font-size: 13.5px; color: var(--ink); transition: all .2s; }
  .ab-freq.active { box-shadow: inset 0 0 0 1px var(--ink); border-color: var(--ink); }
  .ab-freq input { accent-color: var(--clay); width: 16px; height: 16px; flex: none; margin: 0; }
  .ab-freq .pr { margin-left: auto; white-space: nowrap; }
  .ab-freq .pr .was { text-decoration: line-through; color: var(--ink-soft); margin-right: 6px; }
  .ab-freq .pc { color: var(--clay); font-weight: 600; margin-left: 10px; }
  .ab-card .price .was { font-family: var(--sans); font-size: 16px; text-decoration: line-through; color: var(--ink-soft); margin-right: 8px; }
  .ab-disc-line { font-size: 12.5px; color: var(--clay); font-weight: 600; margin: 2px 0 16px; }

  .ab-cta { width: 100%; margin-top: 8px; padding: 17px; font: 600 12.5px/1 var(--sans); letter-spacing: .12em; text-transform: uppercase; background: var(--ink); color: var(--ivory); border: 1px solid var(--ink); cursor: pointer; transition: all .3s; }
  .ab-cta:hover:not(:disabled) { background: var(--clay-dark); border-color: var(--clay-dark); }
  .ab-cta:disabled { opacity: .4; cursor: not-allowed; }
  .ab-note { font-size: 12px; color: var(--ink-soft); margin-top: 12px; text-align: center; }
  .ab-feats { list-style: none; margin: 22px 0 0; padding: 22px 0 0; border-top: 1px solid var(--line); display: flex; flex-direction: column; gap: 9px; }
  .ab-feats li { font-size: 13px; color: var(--ink-soft); padding-left: 20px; position: relative; }
  .ab-feats li::before { content: '—'; position: absolute; left: 0; color: var(--clay); }

  /* surprise visual */
  .ab-surprise-ph { aspect-ratio: 16/8; background: linear-gradient(165deg, var(--sand), var(--sand-deep)); display: flex; align-items: center; justify-content: center; margin-bottom: 24px; overflow: hidden; }
  .ab-surprise-ph img { width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 14px 18px rgba(33,29,24,.22)); }
  .ab-surprise-ph .placeholder { font-family: var(--serif); font-style: italic; font-size: 26px; color: var(--ink-soft); }

  /* faq */
  .ab-faq { padding: 0 0 110px; }
  .ab-faq .head { text-align: center; margin-bottom: 40px; }
  .ab-faq .head h2 { font-size: clamp(28px, 3vw, 42px); }
  .ab-faq .list { max-width: 760px; margin: 0 auto; }
  .ab-faq details { border-top: 1px solid var(--line); padding: 22px 0; }
  .ab-faq details:last-child { border-bottom: 1px solid var(--line); }
  .ab-faq summary { font-family: var(--serif); font-size: 21px; cursor: pointer; list-style: none; display: flex; justify-content: space-between; align-items: center; }
  .ab-faq summary::-webkit-details-marker { display: none; }
  .ab-faq summary::after { content: '+'; font-family: var(--sans); font-size: 22px; color: var(--clay); }
  .ab-faq details[open] summary::after { content: '–'; }
  .ab-faq details p { margin-top: 12px; color: var(--ink-soft); font-size: 15px; line-height: 1.7; max-width: 64ch; }
</style>
